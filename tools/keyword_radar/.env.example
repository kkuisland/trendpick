# 이 파일을 .env 로 복사한 뒤 값을 채우세요. (.env 는 남에게 공유하지 마세요)

# 네이버 클라우드 콘솔 > Services > Application Service > NAVER API HUB > 이용 신청
# 앱 등록 시 API: '블로그 검색' + '검색어 트렌드' 선택 -> Client ID / Client Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 네이버 검색광고 > 도구 > API 사용관리 (월간 검색수용, 광고비 안 써도 발급 가능)
NAVER_AD_CUSTOMER_ID=
NAVER_AD_ACCESS_LICENSE=
NAVER_AD_SECRET_KEY=
